<Window x:Class="STOdatabase.Window3"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STOdatabase"
        mc:Ignorable="d"
        Title="Редактирование записей" Height="450" Width="800">
    <Grid Background="#FFCCC782">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="OrdersGrid" SelectionChanged="OrdersGrid_SelectionChanged" Background="#FFCCC782" Grid.Row="0" AutoGenerateColumns="True" Grid.ColumnSpan="5" IsReadOnly="True" AutoGeneratedColumns="OrdersGrid_AutoGeneratedColumns"/>

        <DatePicker x:Name="date" HorizontalAlignment="Left" Height="25" Margin="34,31,0,0" Grid.Row="1" VerticalAlignment="Top" Width="148"/>
        <ComboBox x:Name="idAuto"  Grid.Column="1" DisplayMemberPath="Номер машины" SelectedValuePath="id Авто" HorizontalAlignment="Left" Height="25" Margin="8,27,0,0" Grid.Row="1"  VerticalAlignment="Top" Width="90" />
        <Label Grid.Column="1" Content="Выберите Авто:" HorizontalAlignment="Left" Margin="5,1,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <ComboBox x:Name="idMaster"  Grid.Column="1" DisplayMemberPath="ФИО" SelectedValuePath="id Мастера" HorizontalAlignment="Left" Height="25" Margin="142,27,0,0" Grid.Row="1"  VerticalAlignment="Top" Width="200" Grid.ColumnSpan="2"/>
        <Label Grid.Column="1" Content="Выберите Мастера:" HorizontalAlignment="Center" Margin="0,1,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <ListBox x:Name="idUsluga"  Grid.Column="2" SelectionMode="Multiple"  HorizontalAlignment="Left" Height="115" Margin="168,27,0,0" Grid.Row="1"  VerticalAlignment="Top" Width="214" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Label Grid.Column="2" Content="Выберите Услугу:" HorizontalAlignment="Left" Margin="168,1,0,0" VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.Row="1"/>
        <Button x:Name="btnAdd" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Height="39" Width="150" Content="Добавить заказ" Click="AddZakaz" Margin="33,103,0,0" Background="#FFDDDDDD"/>
        <Label Content="Выберите дату:" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Margin="35,5,0,0"/>
        <Button x:Name="btnEdit"  Content="Редактировать" HorizontalAlignment="Center" Height="39"  Grid.Row="1" VerticalAlignment="Bottom" Width="174"  Grid.ColumnSpan="2" Visibility="Visible" Grid.Column="1" Click="btnEdit_Click" />
        <Button x:Name="btnBack" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" Height="30" Width="114" Content="Назад" Click="btnBack_Click" Margin="51,10,0,0" Background="#FFDDDDDD"/>


    </Grid>
</Window>
