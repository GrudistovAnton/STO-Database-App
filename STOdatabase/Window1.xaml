<Window x:Class="STOdatabase.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STOdatabase"
        mc:Ignorable="d"
        Title="Добавление заказа" Height="450" Width="800">
    <Grid Background="#FFCCC782">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="OrdersGrid" Background="#FFCCC782" Grid.Row="0" AutoGenerateColumns="True" Grid.ColumnSpan="5" IsReadOnly="True"/>
        <DatePicker x:Name="date" HorizontalAlignment="Left" Height="25" Margin="34,36,0,0" Grid.Row="1" VerticalAlignment="Top" Width="148"/>
        <ComboBox x:Name="idAuto" Grid.Column="1" DisplayMemberPath="Номер машины" SelectedValuePath="id Авто" HorizontalAlignment="Left" Height="25" Margin="8,32,0,0" Grid.Row="1"  VerticalAlignment="Top" Width="90" />
        <Label Grid.Column="1" Content="Выберите Авто:" HorizontalAlignment="Left" Margin="5,6,0,0" Grid.Row="1" VerticalAlignment="Top"/>
        <ComboBox x:Name="idMaster"  Grid.Column="1" DisplayMemberPath="ФИО" SelectedValuePath="id Мастера" HorizontalAlignment="Left" Height="25" Margin="141,32,0,0" Grid.Row="1"  VerticalAlignment="Top" Width="200" Grid.ColumnSpan="2"/>
        <Label Grid.Column="1" Content="Выберите Мастера:" HorizontalAlignment="Left" Margin="141,6,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2"/>

        <ListBox x:Name="idUsluga"  Grid.Column="2" SelectionMode="Multiple"  HorizontalAlignment="Left" Height="115" Margin="160,32,0,0" Grid.Row="1"  VerticalAlignment="Top" Width="214" Grid.ColumnSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Label Grid.Column="2" Content="Выберите Услуги:" HorizontalAlignment="Left" Margin="160,6,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
        <Button x:Name="btnAdd" HorizontalAlignment="Center" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="39" Width="150"   Grid.Column="1" Content="Добавить заказ" Click="AddZakaz" Margin="0,108,0,0" Background="#FFDDDDDD"/>
        <Label Content="Выберите дату:" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Margin="35,10,0,0"/>
        <Button x:Name="btnEdit"  Content="Редактировать" HorizontalAlignment="Left" Grid.Row="1" VerticalAlignment="Top" Height="39" Width="150" Margin="33,108,0,0" Click="btnEdit_Click" />
        <Button x:Name="btnBack" HorizontalAlignment="Left" Grid.Row="2" VerticalAlignment="Top" Height="30" Width="114" Content="Назад" Click="btnBack_Click" Margin="51,20,0,0" Background="#FFDDDDDD"/>

    </Grid>
</Window>
