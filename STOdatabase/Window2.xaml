<Window x:Class="STOdatabase.Window2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:STOdatabase"
        mc:Ignorable="d"
        Title="База данных" Height="450" Width="800">
    <Grid Background="#FFCCC782">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="OrdersGrid" Background="#FFCCC782" Grid.Row="0" AutoGenerateColumns="True"  IsReadOnly="True"/>
        <Button x:Name="btnDelete" Content="Удалить заказ" HorizontalAlignment="Left" Margin="36,0,0,0" Grid.Row="1" VerticalAlignment="Center" Height="42" Width="116" Click="Button_Click"/>
        <Button x:Name="btnBack" Content="Назад" HorizontalAlignment="Left" Margin="674,0,0,0" Grid.Row="1" VerticalAlignment="Center" Height="42" Width="116" Click="btnBack_Click"/>
        <Button x:Name="btnEdit" Content="Редактировать" HorizontalAlignment="Left" Margin="198,0,0,0" Grid.Row="1" VerticalAlignment="Center" Height="42" Width="116" Click="btnEdit_Click"/>
    </Grid>
</Window>
